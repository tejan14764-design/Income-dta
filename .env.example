# =============================================================
# INCOME – Environment Variables Example
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================

# ---- Django Backend ----
SECRET_KEY=your-very-secret-django-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
DB_NAME=income_db
DB_USER=income_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ---- CORS ----
# Comma-separated list of allowed origins for the frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Media / File Uploads ----
MEDIA_ROOT=media/
MAX_UPLOAD_SIZE_MB=10

# ---- Email (for password reset) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=INCOME System <noreply@income.school>

# ---- JWT / Auth ----
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=INCOME
VITE_APP_VERSION=1.0.0

# ---- Electron (production) ----
# Set this to your production server URL for the packaged desktop app
ELECTRON_API_URL=http://localhost:8000/api/v1

# ---- School (default seed) ----
DEFAULT_SCHOOL_NAME=My School
DEFAULT_SCHOOL_EMAIL=admin@myschool.edu
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@12345!
