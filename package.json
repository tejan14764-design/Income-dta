{
  "name": "income-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "INCOME – School Student Information and Financial Management System",
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/shared-types",
    "packages/shared-validation",
    "packages/shared-utils"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "build:web": "npm run build --workspace=apps/web",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "build:installer": "npm run build:installer --workspace=apps/desktop",
    "lint": "npm run lint --workspaces --if-present",
    "test:frontend": "npm run test --workspace=apps/web",
    "backend:dev": "cd backend && python manage.py runserver",
    "backend:migrate": "cd backend && python manage.py migrate",
    "backend:createsuperuser": "cd backend && python manage.py createsuperuser"
  },
  "devDependencies": {
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
